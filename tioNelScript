funkey () {
    claro&claro
    mensaje -barra3
    echo -e "\e[5m\e[1;37m\e[48;5;235m =====>> ► ► ⚡ el_tioNel ⚡ ◄◄ <<===== \e[0m"
    mensaje -barra3
    barra de mensajes
    echo -e "\033[1;33m DESCARGANDO E INSTALANDO tioNelScript DESDE GITHUB ..."
    [[ ! -d ${SCPdir} ]] && mkdir -p ${SCPdir}
    [[ ! -d /etc/adm-lite/slow ]] && mkdir -p /etc/adm-lite/slow
    [[ ! -d /etc/ADMcgh ]] && mkdir -p /etc/ADMcgh

    cd /etc
    echo " > obteniendo adm-lite.tar.gz ..."
    if wget -q -4 "${GITHUB_RAW}/adm-lite.tar.gz" -O adm-lite.tar.gz; then
        tar -xf adm-lite.tar.gz >/dev/null 2>&1
        chmod -R +x ${SCPdir} 2>/dev/null
        rm -f adm-lite.tar.gz
    demás
        echo " ! FALLO al descargar adm-lite.tar.gz"
        clave_inválida
    fi

    cd ${SCPdir}
    wget -q -4 "${GITHUB_RAW}/install2" -O install2 && chmod +x install2
    wget -q -4 "${GITHUB_RAW}/menu_inst" -O menu_inst && chmod +x menu_inst
    wget -q -4 "${GITHUB_RAW}/Otros/v-new.log" -O /etc/adm-lite/local.txt 2>/dev/null
    [[ ! -s /etc/adm-lite/local.txt ]] && echo "v6=1.4.60" > /etc/adm-lite/local.txt

    mkdir -p /bin/ejecutar
    wget -q -O /bin/ejecutar/msg "${GITHUB_RAW}/Otros/ejecutar/msg" 2>/dev/null || cp -f ${SCPdir}/Otros/msg /bin/ejecutar/msg 2>/dev/null
    chmod +x /bin/ejecutar/msg 2>/dev/null

    echo "Verificado【 ChumoGH" > /bin/ejecutar/exito
    eco "v6=1.4.60" > /bin/ejecutar/v-new.log
    eco "0" > /bin/ejecutar/uskill
    eco "PandaHL001" > /etc/cghkey
    IP=$(wget -q -4 -O - http://ipv4.icanhazip.com 2>/dev/null | tr -d '[:space:]')
    [[ -z "$IP" ]] && IP=$(ip addr | grep 'inet ' | grep -v 127.0.0.1 | awk '{print $2}' | cut -d/ -f1 | head -1)
    echo "$IP" > /bin/ejecutar/IPcgh
    echo "$fecha" > /bin/ejecutar/fecha
    free -h | grep Mem | sed 's/\s\+/,/g' | cut -d , -f4 > /bin/ejecutar/raml
    [[ -e ${SCPdir}/menu_credito ]] && cat ${SCPdir}/menu_credito > /bin/ejecutar/menu_credito || echo "ChumoGH" > /bin/ejecutar/menu_credito
    chmod +x /bin/ejecutar/* 2>/dev/null

    eco "v6" > /etc/ADMcgh/v-local.log
    eco "v6" > /etc/adm-lite/v-local.log
    eco "v6=1.4.60" > /etc/adm-lite/local.txt

    echo '#!/bin/bash
SCPdir="/etc/adm-lite"
cd ${SCPdir} && ./menu' > /bin/menu && chmod +x /bin/menu
    echo '#!/bin/bash
SCPdir="/etc/adm-lite"
cd ${SCPdir} && ./menu' > /bin/cgh && chmod +x /bin/cgh
    echo '#!/bin/bash
SCPdir="/etc/adm-lite"
cd ${SCPdir} && ./menu' > /bin/adm && chmod +x /bin/adm

    chmod -R 755 ${SCPdir}
    chmod +x ${SCPdir}/códigos de usuario ${SCPdir}/menu ${SCPdir}/ferramentas ${SCPdir}/cabecalho 2>/dev/null
    barra de mensajes
    echo -e "\033[1;32m >> tioNelScript DESCARGADO <<\033[0m"
    barra de mensajes
}

